#!/usr/bin/python3
"""cellar: restic backups to an S3-compatible bucket and an optional local copy, with checks and restore drills.

Usage:
  cellar [--b2 | --local] COMMAND
  cellar backup [--tag TAG]     back up everything in sources.txt (default tag: manual)
  cellar check [--subset N/52]  verify the repository and a slice of its data (default: this ISO week's slice;
                                the local copy is read in full)
  cellar drill                  restore the files in drill.txt to a temp dir and check them (the local copy
                                restores the whole latest snapshot)
  cellar status [--json]        show the last results (from /var/lib/cellar/status.json)
  cellar snapshots              list snapshots
  cellar sources                show which source paths exist and which are missing
  cellar restore SNAPSHOT --target DIR [--include PATTERN ...]
  cellar restic ARGS...         run restic with cellar's credentials
  cellar init                   create the repository if it doesn't exist yet
  cellar stopped JOB            for the units' ExecStopPost: records a run that was killed

The off-site repository is set in b2.env. The local copy (local.env, usually an append-only rest-server on
another machine on the LAN) is optional. backup, check and drill run against every configured repository;
the other commands use the off-site one unless given --local. --b2 or --local limits any command to one.

Settings live in /etc/cellar (see etc/*.example in the repo). Needs root.
"""
import argparse
import contextlib
import datetime
import fcntl
import glob
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import signal
import socket
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request

ETC = "/etc/cellar"
STATE = "/var/lib/cellar"
STATUS = f"{STATE}/status.json"
STATUS_LOCK = f"{STATE}/status.lock"
LOCK = f"{STATE}/lock"
STAGING = f"{STATE}/staging"
WORK = f"{STATE}/work"
# restic's temporary pack files. Kept on disk because /tmp is often RAM (tmpfs).
TMP = f"{STATE}/tmp"
CACHE = "/var/cache/cellar"
SCHEMA = 1

KEEP = ["--keep-daily", "7", "--keep-weekly", "5", "--keep-monthly", "12"]
# Half-hourly snapshots (tag "frequent") are short-term restore points: kept for a day, left out
# of KEEP so they never crowd out the dailies, and only pruned by the nightly run.
FREQUENT = "frequent"
KEEP_FREQUENT = ["--keep-within", "24h"]
# Snapshots are grouped by host and tag, never by path list, so a change to what sources.txt
# matches doesn't start a new retention group or force a full rescan.
FORGET_GROUP = ["--group-by", "host,tags"]
PARENT_GROUP = ["--group-by", "host"]
# Repacking during prune downloads data, and B2's daily download cap blocks every read once it's
# hit. This bounds what one nightly prune can download; the rest is repacked on later nights.
DEFAULT_MAX_REPACK = "300M"
RCON_TIMEOUT = 120
SAVE_ON_TIMEOUT = 20
PRE_BACKUP_TIMEOUT = 1800
# How long the local copy's server may take to accept a connection before its run is given up.
PROBE_TIMEOUT = 10
# The local copy is pruned by the machine that stores it. Frequent snapshots this much older than the newest
# one mean that machine's prune has stopped running.
PRUNE_OVERDUE = datetime.timedelta(hours=48)

# Copies a live SQLite database with the backup API and checks the copy. Runs as the
# database's owner so SQLite never creates root-owned -wal/-shm files next to the original.
SQLITE_COPY = """
import sqlite3, sys, urllib.parse
src = sqlite3.connect("file:" + urllib.parse.quote(sys.argv[1]) + "?mode=ro", uri=True)
dst = sqlite3.connect(sys.argv[2])
src.backup(dst)
result = dst.execute("pragma integrity_check").fetchone()[0]
tables = dst.execute("select count(*) from sqlite_master").fetchone()[0]
dst.close()
src.close()
if result != "ok":
    sys.exit(f"integrity_check failed: {result}")
if not tables:
    sys.exit("the copy has no tables")
"""


class Failed(Exception):
    pass


class Stopped(BaseException):
    """SIGTERM from systemd. A BaseException, so cleanup code that catches Exception doesn't swallow it."""


class Busy(Exception):
    """Another cellar job holds the lock."""


class Problems:
    """Things that went wrong without losing the snapshot. alert means someone should look now."""

    def __init__(self):
        self.items = []
        self.alert = False

    def add(self, msg, alert=False):
        log(f"WARNING: {msg}")
        self.items.append(msg)
        self.alert = self.alert or alert

    def __str__(self):
        return "; ".join(self.items)


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def log(msg):
    print(msg, flush=True)


def env_value(raw):
    """A value from a KEY=value line: one pair of matching quotes, or an unquoted value ending at ' #'."""
    raw = raw.strip()
    if raw[:1] in ("'", '"'):
        end = raw.find(raw[0], 1)
        return raw[1:end] if end != -1 else raw[1:]
    return re.split(r"\s+#", raw, maxsplit=1)[0].strip()


def read_env(path):
    env = {}
    if not os.path.exists(path):
        return env
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            if key.startswith("export "):
                key = key[len("export "):].strip()
            env[key] = env_value(value)
    return env


def read_list(name):
    path = f"{ETC}/{name}"
    if not os.path.exists(path):
        return []
    with open(path) as f:
        return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]


CONF = read_env(f"{ETC}/cellar.env")


class Repo:
    """A restic repository cellar writes to.

    key is the status.json section its results go under (None = the top level, kept as it always was for
    the off-site repository). A repository with prunes=False is append-only to this machine: the machine that
    stores it runs forget and prune, so cellar never does.
    """

    def __init__(self, name, env_file, pass_file, key, prunes):
        self.name, self.env_file, self.pass_file, self.key, self.prunes = name, env_file, pass_file, key, prunes

    def env(self):
        return read_env(f"{ETC}/{self.env_file}")

    def configured(self):
        return bool(self.env().get("RESTIC_REPOSITORY"))

    def label(self):
        return "local copy" if self is LOCAL else "off-site"

    def probe(self):
        """Fail fast when a rest-server repository's host doesn't answer, instead of letting restic retry
        for minutes while the Minecraft servers wait with auto-save off."""
        url = self.env().get("RESTIC_REPOSITORY", "")
        if not url.startswith("rest:"):
            return
        u = urllib.parse.urlsplit(url[len("rest:"):])
        port = u.port or (443 if u.scheme == "https" else 80)
        try:
            socket.create_connection((u.hostname, port), timeout=PROBE_TIMEOUT).close()
        except OSError as e:
            raise Failed(f"{self.label()} server {u.hostname}:{port} isn't reachable: {e}") from None

    def __repr__(self):
        return f"Repo({self.name})"


B2 = Repo("b2", "b2.env", "restic.pass", None, prunes=True)
LOCAL = Repo("local", "local.env", "local.pass", "local", prunes=False)


def restic_env(repo=B2):
    settings = repo.env()
    if not settings.get("RESTIC_REPOSITORY"):
        raise Failed(f"{ETC}/{repo.env_file} is missing or has no RESTIC_REPOSITORY")
    env = dict(os.environ, **settings)
    env["RESTIC_PASSWORD_FILE"] = f"{ETC}/{repo.pass_file}"
    env.setdefault("RESTIC_CACHE_DIR", CACHE)
    os.makedirs(TMP, mode=0o700, exist_ok=True)
    env["TMPDIR"] = TMP
    return env


def restic(*args, ok=(0,), quiet=False, capture=True, repo=B2, env=None):
    """Run restic, echo its stderr, return (exit code, stdout). Raises unless the code is in ok.
    With capture=False restic writes straight to the terminal (progress for long restores)."""
    cmd = ["restic", "--retry-lock", "30m", *args]
    env = env or restic_env(repo)
    where = "" if repo is B2 else f" ({repo.label()})"
    if not capture:
        p = subprocess.run(cmd, env=env)
        if p.returncode not in ok:
            raise Failed(f"restic {args[0]}{where}: exit code {p.returncode}")
        return p.returncode, ""
    p = subprocess.run(cmd, env=env, text=True, capture_output=True)
    if p.stderr and not quiet:
        sys.stderr.write(p.stderr)
    if p.returncode not in ok:
        tail = " ".join(p.stderr.strip().splitlines()[-3:]) or f"exit code {p.returncode}"
        raise Failed(f"restic {args[0]}{where}: {tail}")
    return p.returncode, p.stdout


def restic_json(*args, repo=B2):
    return json.loads(restic("--json", *args, repo=repo)[1])


def json_lines(out):
    """restic --json output, one message per line; anything that isn't JSON is skipped."""
    for line in out.splitlines():
        if line.startswith("{"):
            try:
                yield json.loads(line)
            except ValueError:
                continue


@contextlib.contextmanager
def flocked(path, wait=True):
    """An exclusive flock on path. With wait=False, raises Busy instead of waiting."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            raise Busy(path) from None
        yield
    finally:
        os.close(fd)


def locked(wait=True):
    """The job lock: one backup, check or drill at a time."""
    return flocked(LOCK, wait)


def lock_held():
    try:
        with locked(wait=False):
            return False
    except Busy:
        return True


def load_status():
    try:
        with open(STATUS) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def status_section(data, repo, name):
    """A repository's section from loaded status data, or {}."""
    if repo.key:
        data = data.get(repo.key) or {}
    return data.get(name) or {}


def status_merge(under=None, **sections):
    """Merge sections into status.json, or into its `under` section (the local copy's). Serialized with its
    own lock, written atomically."""
    with flocked(STATUS_LOCK):
        try:
            data = load_status()
        except ValueError:
            # Shouldn't happen now that writes are atomic; keep the evidence instead of merging into it.
            log(f"WARNING: {STATUS} was unreadable; moved it to {STATUS}.bad")
            os.replace(STATUS, STATUS + ".bad")
            data = {}
        if under:
            target = data.get(under)
            if not isinstance(target, dict):
                target = data[under] = {}
            target.update(sections)
            target["updated"] = now()
        else:
            data.update(sections)
        data["schema"] = SCHEMA
        data["updated"] = now()
        fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".status-")
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp, 0o644)
            os.replace(tmp, STATUS)
        except BaseException:
            with contextlib.suppress(OSError):
                os.unlink(tmp)
            raise
    return data


def healthcheck(job, suffix="", body="", repo=B2):
    """Ping healthchecks.io for job (nightly, frequent, manual, check or drill).

    The nightly backup uses HC_URL; frequent, check and drill use HC_URL_FREQUENT, HC_URL_CHECK and
    HC_URL_DRILL when set. Without their own URL their failures still go to HC_URL as /fail, so
    nothing fails silently, but their successes never mark a failed nightly as fine.
    Manual runs don't ping: whoever ran them saw the result.

    The local copy has one check of its own, HC_URL_LOCAL: its nightly backup pings /start and success
    there, and its frequent backups, checks and drills send only their failures. Without HC_URL_LOCAL,
    nightly, check and drill failures of the local copy go to HC_URL as /fail; frequent ones are left to
    status.json, so a backup host that is off for a while doesn't alert every half hour.
    """
    if repo is LOCAL:
        if job == "manual" or (job != "nightly" and suffix != "/fail"):
            return
        url = CONF.get("HC_URL_LOCAL")
        if not url and suffix == "/fail" and job != FREQUENT:
            url = CONF.get("HC_URL")
        body = f"local copy, {job}: {body}"
    elif job == "nightly":
        url = CONF.get("HC_URL")
    elif job == "manual":
        url = None
    else:
        url = CONF.get(f"HC_URL_{job.upper()}")
        if not url and suffix == "/fail":
            url = CONF.get("HC_URL")
    if not url:
        return
    try:
        req = urllib.request.Request(url.rstrip("/") + suffix, data=body[-10000:].encode())
        urllib.request.urlopen(req, timeout=10)
    except Exception as e:
        log(f"healthchecks ping failed: {e}")


def sources():
    """Expand sources.txt globs. Returns (existing paths, lines that matched nothing)."""
    found, missing = [], []
    for line in read_list("sources.txt"):
        matches = sorted(glob.glob(line))
        if not matches:
            missing.append(line)
        for m in map(os.path.realpath, matches):
            if m not in found:
                found.append(m)
    return found, missing


def copy_regular_file(src, dst):
    """Copy src to a new root-only dst without following a symlink at src (src's dir isn't root's)."""
    fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
    with open(fd, "rb") as fin:
        if not stat.S_ISREG(os.fstat(fin.fileno()).st_mode):
            raise Failed(f"{src} isn't a regular file")
        with contextlib.suppress(FileNotFoundError):
            os.unlink(dst)
        with open(os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as fout:
            shutil.copyfileobj(fin, fout, 1 << 20)


def sqlite_list():
    """sqlite.txt lines: a path, or "nightly <path>" for a database only copied by nightly and manual runs."""
    out = []
    for line in read_list("sqlite.txt"):
        nightly_only = line.startswith("nightly ")
        out.append((line[len("nightly "):].strip() if nightly_only else line, nightly_only))
    return out


def stage(frequent=False):
    """Fill the staging dir with consistent copies of live SQLite databases.

    Frequent runs keep the last copy of a "nightly" database instead of copying it again: a large,
    busy database would otherwise add most of its size to every half-hourly snapshot.
    """
    if not frequent:
        shutil.rmtree(STAGING, ignore_errors=True)
    shutil.rmtree(WORK, ignore_errors=True)
    os.makedirs(STAGING, mode=0o700, exist_ok=True)
    os.makedirs(WORK, mode=0o755)
    for src, nightly_only in sqlite_list():
        if not os.path.isfile(src):
            raise Failed(f"sqlite.txt lists {src}, which doesn't exist")
        dst = STAGING + src
        if frequent and nightly_only and os.path.isfile(dst):
            log(f"kept the last copy of {src}")
            continue
        owner = pwd.getpwuid(os.stat(src).st_uid)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        with tempfile.TemporaryDirectory(dir=WORK) as tmp:
            os.chown(tmp, owner.pw_uid, owner.pw_gid)
            out = os.path.join(tmp, "copy.db")
            p = subprocess.run(["runuser", "-u", owner.pw_name, "--", "python3", "-c", SQLITE_COPY, src, out],
                               text=True, capture_output=True)
            if p.returncode != 0:
                raise Failed(f"copying {src}: {p.stderr.strip()}")
            copy_regular_file(out, dst)
        log(f"staged {src} ({os.path.getsize(dst)} bytes)")


def pre_backup(problems):
    """Run cellar.env's PRE_BACKUP command before restic reads the sources.

    Meant for filling a source path from elsewhere, e.g. pulling a consistent copy of a game world
    from another machine. A failure is alerted but doesn't stop the backup: everything else is still
    saved, and the path keeps its last good copy.
    """
    cmd = CONF.get("PRE_BACKUP", "").strip()
    if not cmd:
        return
    try:
        p = subprocess.run(shlex.split(cmd), text=True, capture_output=True, timeout=PRE_BACKUP_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        problems.add(f"PRE_BACKUP failed, its paths hold the last good copy ({e})", alert=True)
        return
    for line in (p.stdout + p.stderr).splitlines():
        log(f"PRE_BACKUP: {line}")
    if p.returncode != 0:
        last = (p.stderr or p.stdout).strip().splitlines()[-1:] or [f"exit {p.returncode}"]
        problems.add(f"PRE_BACKUP failed, its paths hold the last good copy ({last[0]})", alert=True)


def rcon(cmd, *args, timeout=RCON_TIMEOUT):
    try:
        p = subprocess.run([cmd, *args], text=True, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Failed(f"{cmd} {' '.join(args)}: {e}") from None
    if p.returncode != 0:
        raise Failed(f"{cmd} {' '.join(args)}: {(p.stderr or p.stdout).strip()}")
    return p.stdout.strip()


def minecraft_servers():
    servers = []
    for pair in CONF.get("MINECRAFT", "").split():
        unit, sep, cmd = pair.partition(":")
        if not (sep and unit and cmd):
            raise Failed(f"cellar.env: MINECRAFT entry {pair!r} isn't unit:command")
        servers.append((unit, cmd))
    return servers


@contextlib.contextmanager
def minecraft_paused(problems):
    """Turn off auto-save on running Minecraft servers while the backup reads their worlds.

    A server that can't be paused (RCON not up yet after a reboot) is backed up anyway and noted.
    save-on runs with SIGTERM blocked, so a stop can't cut the loop short and leave a server
    with auto-save off; a SIGTERM that arrives meanwhile is handled right after.
    """
    paused = []
    try:
        for unit, cmd in minecraft_servers():
            if subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode != 0:
                continue
            try:
                rcon(cmd, "save-off")
            except Failed as e:
                problems.add(f"{unit}: couldn't pause auto-save, backed up while it was saving ({e})")
                continue
            paused.append((unit, cmd))
            try:
                log(f"{unit}: {rcon(cmd, 'save-all flush')}")
            except Failed as e:
                problems.add(f"{unit}: save-all flush failed, the world may be a few minutes old ({e})")
        yield
    finally:
        old = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM})
        try:
            for unit, cmd in paused:
                for attempt in (1, 2):
                    try:
                        rcon(cmd, "save-on", timeout=SAVE_ON_TIMEOUT)
                        log(f"{unit}: save-on")
                        break
                    except Failed as e:
                        if attempt == 2:
                            problems.add(f"{unit}: save-on failed, auto-save is still OFF ({e})", alert=True)
                        else:
                            time.sleep(5)
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, old)


def source_sizes(snapshot, paths):
    """Bytes per source path in an off-site snapshot, from `restic ls`."""
    sizes = {p: 0 for p in paths}
    _, out = restic("--json", "ls", snapshot)
    by_length = sorted(paths, key=len, reverse=True)
    for node in json_lines(out):
        if node.get("type") != "file" or "path" not in node:
            continue
        for p in by_length:
            if node["path"] == p or node["path"].startswith(p.rstrip("/") + "/"):
                sizes[p] += node.get("size", 0)
                break
    return [{"path": p, "bytes": b} for p, b in sizes.items()]


def snapshot_time(s):
    return datetime.datetime.fromisoformat(s["time"].replace("Z", "+00:00"))


def overdue_frequent(snaps):
    """Frequent snapshots more than PRUNE_OVERDUE older than the newest one: the prune that should have
    removed them (run by the machine storing an append-only copy) isn't running."""
    times = [snapshot_time(s) for s in snaps if FREQUENT in (s.get("tags") or []) and s.get("time")]
    if not times:
        return 0
    newest = max(times)
    return sum(1 for t in times if newest - t > PRUNE_OVERDUE)


def repo_stats(repo=B2, snaps=None):
    if snaps is None:
        snaps = restic_json("snapshots", repo=repo)
    raw = restic_json("stats", "--mode", "raw-data", repo=repo)
    return {"snapshots": len(snaps), "size_bytes": raw.get("total_size", 0), "measured": now()}


def prune_options():
    size = CONF.get("PRUNE_MAX_REPACK", DEFAULT_MAX_REPACK)
    return ["--max-repack-size", size] if size else []


def backup_kind(tag):
    return tag if tag in ("nightly", FREQUENT) else "manual"


def configured_repos(args, single=False):
    """The repositories a command works on. --b2/--local pick one; otherwise backup, check and drill use
    every configured repository (single=False) and the rest use the off-site one."""
    only = getattr(args, "only", None)
    if only:
        repo = LOCAL if only == "local" else B2
        if repo is LOCAL and not LOCAL.configured():
            raise Failed(f"there's no local copy: {ETC}/{LOCAL.env_file} is missing or has no RESTIC_REPOSITORY")
        return [repo]
    if single:
        return [B2]
    return [B2] + ([LOCAL] if LOCAL.configured() else [])


def cmd_backup(args):
    kind = backup_kind(args.tag)
    repos = configured_repos(args)
    try:
        # A frequent run that finds another job running is redundant; skip it rather than queue.
        with locked(wait=kind != FREQUENT):
            run_backup(args.tag, kind, repos)
    except Busy:
        log("another cellar job is running; skipping this frequent backup")


class BackupRun:
    """One repository's part of a backup job: its status record, its problems and its pings.

    Each repository succeeds or fails on its own, so an unreachable local copy never fails the off-site
    backup, and an off-site outage (a B2 cap, say) still leaves a fresh local snapshot.
    """

    def __init__(self, repo, tag, kind):
        self.repo, self.tag, self.kind = repo, tag, kind
        # Frequent runs have their own section so they can't hide a failed or missing nightly.
        self.section = "frequent" if kind == FREQUENT else "backup"
        self.record = {"started": now(), "finished": None, "result": "running", "error": None, "tag": tag}
        self.problems = Problems()
        self.extra = {}
        self.error = None
        self.done = False

    def save(self, **extra):
        status_merge(under=self.repo.key, **{self.section: self.record}, **extra)

    def ping(self, suffix="", body=""):
        healthcheck(self.kind, suffix, body, repo=self.repo)

    def begin(self):
        if self.kind == FREQUENT:
            with contextlib.suppress(ValueError):
                self.record["last_success"] = status_section(load_status(), self.repo, self.section).get("last_success")
        self.save()
        self.ping("/start")

    def backup(self, paths, missing, exclude):
        """restic backup. A Failed is kept on the run instead of raised, so the next repository still runs."""
        try:
            self.repo.probe()
            code, out = restic("--json", "backup", *PARENT_GROUP, "--tag", self.tag, *exclude, *paths,
                               ok=(0, 3), repo=self.repo)
        except Failed as e:
            self.error = str(e)
            log(f"{self.repo.label()} backup failed: {e}")
            return
        # Recorded before the servers resume, so a stop during save-on still knows the snapshot.
        summary = next((m for m in json_lines(out) if m.get("message_type") == "summary"), {})
        self.record.update(
            snapshot=summary.get("snapshot_id"),
            bytes_added=summary.get("data_added"),
            bytes_uploaded=summary.get("data_added_packed"),
            bytes_total=summary.get("total_bytes_processed"),
            files_new=summary.get("files_new"),
            files_changed=summary.get("files_changed"),
            files_total=summary.get("total_files_processed"),
            missing_sources=missing,
        )
        if code == 3:
            self.problems.add("some files could not be read (see the journal); the snapshot was saved without them")
        # The snapshot exists from here on. Record that first, so a failure in retention or
        # stats below can't turn a saved backup into a "failed" one.
        saved = now()
        if self.kind == FREQUENT:
            self.record["last_success"] = saved
        else:
            self.extra["last_success"] = saved
        self.save(**self.extra)

    def retention(self, paths):
        if self.error:
            return
        try:
            nightly = self.kind != FREQUENT
            if self.repo.prunes:
                restic("forget", *FORGET_GROUP, "--tag", FREQUENT, *KEEP_FREQUENT, repo=self.repo)
                if nightly:
                    restic("forget", *FORGET_GROUP, *KEEP, "--keep-tag", FREQUENT, "--prune", *prune_options(),
                           repo=self.repo)
            if nightly:
                snaps = restic_json("snapshots", repo=self.repo)
                self.extra["repo"] = repo_stats(self.repo, snaps)
                if self.repo is B2 and self.record["snapshot"]:
                    self.extra["sources"] = source_sizes(self.record["snapshot"], paths)
                if not self.repo.prunes:
                    late = overdue_frequent(snaps)
                    if late:
                        self.problems.add(f"the backup host hasn't pruned this copy: {late} frequent snapshots "
                                          f"are over {PRUNE_OVERDUE.total_seconds() / 3600:.0f} hours old", alert=True)
        except Exception as e:
            self.problems.add(f"snapshot saved, but retention or stats failed: {e}", alert=True)

    def finish(self, shared, error=None):
        """Write the result and ping. error is an exception that stopped the whole job, if any."""
        if self.done:
            return
        self.done = True
        notes = "; ".join(shared.items + self.problems.items)
        error = "; ".join(e for e in (self.error, error) if e)
        if error:
            text = error + (f"; {notes}" if notes else "")
            self.record.update(result="partial" if self.record.get("snapshot") else "failed", error=text,
                               finished=now())
            self.save()
            self.ping("/fail", text)
            return
        self.record.update(result="partial" if notes else "ok", error=notes or None, finished=now())
        self.save(**self.extra)
        where = "" if self.repo is B2 else f" ({self.repo.label()})"
        log(f"backup{where} {self.record['result']}: snapshot {self.record['snapshot']}, "
            f"{self.record['bytes_added']} bytes added")
        if shared.alert or self.problems.alert:
            self.ping("/fail", notes)
        else:
            self.ping("", json.dumps(self.record))


def run_backup(tag, kind, repos=None):
    runs = [BackupRun(repo, tag, kind) for repo in (repos or [B2])]
    for run in runs:
        run.begin()
    shared = Problems()  # problems every snapshot shares: staging, PRE_BACKUP, Minecraft
    try:
        stage(frequent=kind == FREQUENT)
        pre_backup(shared)
        paths, missing = sources()
        if not paths:
            raise Failed(f"no source paths exist; check {ETC}/sources.txt")
        for m in missing:
            log(f"WARNING: source matched nothing: {m}")
        exclude = ["--exclude-file", f"{ETC}/excludes.txt"] if os.path.exists(f"{ETC}/excludes.txt") else []
        # One pause for every repository, so each snapshot holds the same flushed worlds.
        with minecraft_paused(shared):
            for run in runs:
                run.backup(paths, missing, exclude)
        for run in runs:
            run.retention(paths)
            run.finish(shared)
    except BaseException as e:
        error = str(e) or type(e).__name__
        for run in runs:
            run.finish(shared, error)
        raise
    failed = [f"{run.repo.label()}: {run.error}" for run in runs if run.error]
    if failed:
        raise Failed("; ".join(failed))


@contextlib.contextmanager
def job(section, record, repo=B2):
    """Status and healthchecks around a check or drill. The caller holds the job lock."""
    status_merge(under=repo.key, **{section: record})
    healthcheck(section, "/start", repo=repo)
    try:
        yield
    except BaseException as e:
        record.update(result="failed", error=str(e) or type(e).__name__, finished=now())
        status_merge(under=repo.key, **{section: record})
        healthcheck(section, "/fail", record["error"], repo=repo)
        raise
    record.update(result="ok", finished=now())
    status_merge(under=repo.key, **{section: record})
    healthcheck(section, "", json.dumps(record), repo=repo)


def each_repo(repos, section, run):
    """Run a check or drill against each repository in turn. One failing doesn't stop the next."""
    errors = []
    for repo in repos:
        try:
            run(repo)
        except Failed as e:
            errors.append(f"{repo.label()}: {e}")
            log(f"{section} ({repo.label()}) failed: {e}")
    if errors:
        raise Failed("; ".join(errors))


def weekly_subset(today=None):
    """n/52 for this ISO week, so the weekly checks read every pack once a year."""
    week = (today or datetime.date.today()).isocalendar().week
    return f"{(week - 1) % 52 + 1}/52"


def cmd_check(args):
    repos = configured_repos(args)

    def check(repo):
        # Reading the local copy costs nothing, so it's read in full every week.
        subset = args.subset or (weekly_subset() if repo.prunes else "all")
        record = {"started": now(), "finished": None, "result": "running", "error": None, "subset": subset}
        read = "--read-data" if subset == "all" else f"--read-data-subset={subset}"
        with job("check", record, repo):
            restic("check", read, repo=repo)
        log(f"check ({repo.label()}) ok")

    with locked():
        each_repo(repos, "check", check)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def remove_leftovers():
    """Temp dirs a killed run left behind (the SQLite work dir, restored drill files)."""
    shutil.rmtree(WORK, ignore_errors=True)
    for d in glob.glob(f"{STATE}/drill-*"):
        shutil.rmtree(d, ignore_errors=True)


def cmd_drill(args):
    repos = configured_repos(args)

    def run(repo):
        record = {"started": now(), "finished": None, "result": "running", "error": None, "files": []}
        with job("drill", record, repo):
            drill(record, repo, full=not repo.prunes)
        log(f"drill ({repo.label()}) ok")

    with locked():
        remove_leftovers()
        each_repo(repos, "drill", run)


def is_sqlite(path):
    return path.endswith((".db", ".sqlite", ".sqlite3"))


def tree_totals(root):
    """Regular files and their bytes under root, counted the way restic's snapshot summary counts them."""
    files = size = 0
    for dirpath, _, names in os.walk(root):
        for name in names:
            st = os.lstat(os.path.join(dirpath, name))
            if stat.S_ISREG(st.st_mode):
                files += 1
                size += st.st_size
    return files, size


def drill(record, repo=B2, full=False):
    """Restore drill.txt's files (full=True: the whole latest snapshot) with --verify and check them.

    The off-site drill restores only drill.txt, to stay far under B2's daily download cap. The local copy
    costs nothing to read, so its drill restores everything, compares the totals with the snapshot's own
    summary and runs integrity_check on every staged database as well.
    """
    patterns = read_list("drill.txt")
    if not patterns:
        raise Failed(f"{ETC}/drill.txt lists no files")
    with tempfile.TemporaryDirectory(dir=STATE, prefix="drill-") as tmp:
        latest = restic_json("snapshots", "latest", repo=repo)
        if not latest:
            raise Failed("the repository has no snapshots")
        snap = latest[0]
        record["snapshot"] = snap["short_id"]
        record["full"] = full
        summary = snap.get("summary") or {}
        if full and summary.get("total_bytes_processed"):
            need = summary["total_bytes_processed"] * 1.1 + (1 << 30)
            free = shutil.disk_usage(tmp).free
            if free < need:
                raise Failed(f"not enough free space for a full restore: {free / 1e9:.1f} GB free, "
                             f"{need / 1e9:.1f} GB needed")
        includes = [] if full else [a for p in patterns for a in ("--include", p)]
        # --verify re-reads every restored file and compares it with the snapshot.
        restic("restore", record["snapshot"], "--target", tmp, "--verify", *includes, repo=repo)
        problems = []
        if full:
            files, size = tree_totals(tmp)
            record["restored"] = {"files": files, "bytes": size}
            want = (summary.get("total_files_processed"), summary.get("total_bytes_processed"))
            if None not in want and (files, size) != want:
                problems.append(f"restored {files} files / {size} bytes, the snapshot has {want[0]} / {want[1]}")
            log(f"restored the whole snapshot: {files} files, {size} bytes")
        checked = set()
        for pattern in patterns:
            matches = sorted(glob.glob(tmp + pattern, include_hidden=True))
            if not matches:
                problems.append(f"nothing restored for {pattern}")
            for path in matches:
                checked.add(path)
                record["files"].append(drill_file(tmp, path, problems))
        if full:
            staged = sorted(glob.glob(tmp + STAGING + "/**", recursive=True, include_hidden=True))
            dbs = [p for p in staged if is_sqlite(p) and os.path.isfile(p) and p not in checked]
            for path in dbs:
                record["files"].append(drill_file(tmp, path, problems))
        if problems:
            raise Failed("; ".join(problems))


def drill_file(tmp, path, problems):
    entry = {"path": path[len(tmp):], "bytes": os.path.getsize(path), "sha256": sha256(path)}
    if entry["bytes"] == 0:
        problems.append(f"{entry['path']} is empty")
    if is_sqlite(path):
        con = sqlite3.connect("file:" + urllib.parse.quote(path) + "?mode=ro", uri=True)
        entry["integrity"] = con.execute("pragma integrity_check").fetchone()[0]
        con.close()
        if entry["integrity"] != "ok":
            problems.append(f"{entry['path']}: integrity_check {entry['integrity']}")
    log(f"restored {entry['path']} ({entry['bytes']} bytes) {entry.get('integrity', '')}")
    return entry


SECTIONS = {"nightly": "backup", FREQUENT: "frequent", "check": "check", "drill": "drill"}


def cmd_stopped(args):
    """ExecStopPost: if the job was killed (OOM, SIGKILL, timeout) before it could write its result,
    mark it failed instead of leaving it "running" until the next run, and alert."""
    result = os.environ.get("SERVICE_RESULT", "success")
    if result == "success":
        return
    section = SECTIONS[args.job]
    why = f"killed before it finished ({result}: {os.environ.get('EXIT_CODE', '?')} " \
          f"{os.environ.get('EXIT_STATUS', '?')})"
    with contextlib.suppress(ValueError):
        data = load_status()
        for repo in (B2, LOCAL):
            record = status_section(data, repo, section)
            if record.get("result") != "running":
                continue
            record.update(result="failed", error=why, finished=now())
            status_merge(under=repo.key, **{section: record})
            healthcheck(args.job, "/fail", why, repo=repo)
            log(f"{section} ({repo.label()}): {why}")
    if not lock_held():
        remove_leftovers()


def cmd_status(args):
    try:
        data = load_status()
    except (OSError, ValueError) as e:
        sys.exit(f"cellar: can't read {STATUS}: {e}")
    if not data:
        sys.exit("no status yet: cellar hasn't run")
    if args.json:
        print(json.dumps(data, indent=2))
        return
    busy = lock_held()

    def show(block, indent=""):
        for key in ("backup", "frequent", "check", "drill"):
            s = block.get(key) or {}
            result = s.get("result", "never")
            if result == "running" and not busy:
                result = "interrupted"
            line = f"{indent}{key:9} {result:11} {s.get('finished') or s.get('started') or ''}"
            if s.get("error"):
                line += f"  {s['error']}"
            print(line)
        repo = block.get("repo") or {}
        if repo:
            print(f"{indent}repo      {repo.get('snapshots', '?')} snapshots, "
                  f"{repo.get('size_bytes', 0) / 1e9:.2f} GB")

    show(data)
    for s in data.get("sources") or []:
        print(f"  {s.get('bytes', 0) / 1e6:10.1f} MB  {s.get('path')}")
    local = data.get(LOCAL.key)
    if isinstance(local, dict):
        print("local copy:")
        show(local, "  ")


def cmd_sources(args):
    paths, missing = sources()
    for p in paths:
        print(f"ok       {p}")
    for m in missing:
        print(f"missing  {m}")
    if missing:
        sys.exit(1)


def cmd_snapshots(args):
    [repo] = configured_repos(args, single=True)
    print(restic("snapshots", repo=repo)[1], end="")


def cmd_restore(args):
    [repo] = configured_repos(args, single=True)
    includes = [a for p in args.include for a in ("--include", p)]
    restic("restore", args.snapshot, "--target", args.target, *includes, capture=False, repo=repo)
    log(f"restored {args.snapshot} into {args.target}")


def cmd_restic(args):
    [repo] = configured_repos(args, single=True)
    os.execvpe("restic", ["restic", *args.args], restic_env(repo))


def init_env(repo):
    """restic's environment for creating repo. The local copy takes the off-site repository's chunker
    parameters (restic reads only its config and key files), so `restic copy` between the two later
    deduplicates fully, for example to refill one from the other with uploads only."""
    env = restic_env(repo)
    if repo is B2 or not B2.configured():
        return env, []
    b2 = B2.env()
    for k, v in b2.items():
        if k != "RESTIC_REPOSITORY":
            env.setdefault(k, v)
    env["RESTIC_FROM_REPOSITORY"] = b2["RESTIC_REPOSITORY"]
    env["RESTIC_FROM_PASSWORD_FILE"] = f"{ETC}/{B2.pass_file}"
    return env, ["--copy-chunker-params"]


def cmd_init(args):
    [repo] = configured_repos(args, single=True)
    code, _ = restic("cat", "config", ok=(0, 10), quiet=True, repo=repo)
    if code == 0:
        log(f"repository already exists ({repo.label()})")
        return
    env, extra = init_env(repo)
    restic("init", *extra, repo=repo, env=env)
    log(f"repository created ({repo.label()})")


def on_sigterm(*_):
    raise Stopped("stopped by SIGTERM (systemctl stop, or the unit's start timeout ran out)")


def main():
    parser = argparse.ArgumentParser(prog="cellar", description="restic backups for this machine",
                                     usage="cellar [--b2 | --local] COMMAND ...")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("backup")
    p.add_argument("--tag", default="manual")
    p.set_defaults(func=cmd_backup)
    p = sub.add_parser("check")
    p.add_argument("--subset", help="restic --read-data-subset value (default: this ISO week's n/52)")
    p.set_defaults(func=cmd_check)
    sub.add_parser("drill").set_defaults(func=cmd_drill)
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)
    sub.add_parser("sources").set_defaults(func=cmd_sources)
    sub.add_parser("snapshots").set_defaults(func=cmd_snapshots)
    p = sub.add_parser("restore")
    p.add_argument("snapshot")
    p.add_argument("--target", required=True)
    p.add_argument("--include", action="append", default=[])
    p.set_defaults(func=cmd_restore)
    p = sub.add_parser("restic")
    p.add_argument("args", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_restic)
    sub.add_parser("init").set_defaults(func=cmd_init)
    p = sub.add_parser("stopped")
    p.add_argument("job", choices=sorted(SECTIONS))
    p.set_defaults(func=cmd_stopped)
    argv, only = sys.argv[1:], None
    while argv[:1] in (["--b2"], ["--local"]):
        only = argv.pop(0)[2:]
    if argv[:1] == ["restic"]:
        args = argparse.Namespace(func=cmd_restic, args=argv[1:])
    else:
        args = parser.parse_args(argv)
    args.only = only

    if os.geteuid() != 0:
        sys.exit("cellar: run as root (sudo cellar ...)")
    # systemd stops a unit with SIGTERM; turn it into an exception so cleanup (save-on) still runs.
    signal.signal(signal.SIGTERM, on_sigterm)
    try:
        args.func(args)
    except Failed as e:
        sys.exit(f"cellar: {e}")
    except Stopped as e:
        print(f"cellar: {e}", file=sys.stderr)
        sys.exit(143)


if __name__ == "__main__":
    main()
