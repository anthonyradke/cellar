[Unit]
Description=cellar monthly restore drill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cellar drill
# Records the run as failed if it was killed (OOM, timeout) before it could write its result.
ExecStopPost=/usr/local/bin/cellar stopped drill
# Stay out of the way of the game servers.
Nice=10
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
CacheDirectory=cellar
CacheDirectoryMode=0700
# A full restore of the local copy is part of the drill.
TimeoutStartSec=3h
# cellar writes only to /var/lib/cellar, /var/cache/cellar and its repositories.
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
