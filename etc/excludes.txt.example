# /etc/cellar/excludes.txt: restic exclude patterns, one per line.
# Live SQLite files are backed up through sqlite.txt instead, so exclude the originals here.
/etc/pihole/pihole-FTL.db*
/home/you/minecraft/world.bak-*
/home/you/minecraft/logs
/home/you/minecraft/libraries
/home/you/minecraft/versions
# A whole project folder (one with no remote, say): leave out secrets, dependencies and build output.
/home/you/projects/**/.env
/home/you/projects/**/.env.*
/home/you/projects/**/node_modules
/home/you/projects/**/.venv
/home/you/projects/**/__pycache__
/home/you/projects/app/dist
