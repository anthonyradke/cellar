# /etc/cellar/local.env (root, mode 600): the optional local copy, kept on another machine on the LAN
# by an append-only rest-server (see docs/backup-host.md). Write it yourself; without it cellar backs up
# off-site only. The repository password is generated into /etc/cellar/local.pass by install.sh.
RESTIC_REPOSITORY=rest:http://<backup-host>:<port>/<client>/
RESTIC_REST_USERNAME=<client>
RESTIC_REST_PASSWORD=
