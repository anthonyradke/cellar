# /etc/cellar/cellar.env

# Minecraft servers to pause auto-save on while the backup reads their worlds, as unit:rcon-command pairs.
# Only units that are running at backup time are touched. Leave empty if there are none.
MINECRAFT="minecraft:mc"

# Optional healthchecks.io URL. Pinged with /start, then success or /fail. Empty = no pings.
HC_URL=
