# /etc/cellar/cellar.env: KEY=value lines. Values may be quoted; an unquoted " #" starts a comment.

# Minecraft servers to pause auto-save on while the backup reads their worlds, as unit:rcon-command pairs.
# Only units that are running at backup time are touched. Leave empty if there are none.
MINECRAFT="minecraft:mc"

# Optional healthchecks.io URLs. Empty = no pings.
# HC_URL gets /start, then success or /fail, from the nightly backup (a 1-day period suits it).
# Frequent backups, checks and drills ping their own URL when one is set; without one, only their
# failures are sent, to HC_URL as /fail. Manual backups never ping.
HC_URL=
HC_URL_FREQUENT=
HC_URL_CHECK=
HC_URL_DRILL=

# Most data one nightly prune may repack (and so download). Keeps prune under a B2 daily download
# cap; whatever is left is repacked on later nights. Empty = no limit.
PRUNE_MAX_REPACK=300M
